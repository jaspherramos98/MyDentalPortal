# File: MyDentalPortal/.env.example
# Copy to .env and fill in your values

FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string

# Local MongoDB
MONGO_URI=mongodb://localhost:27017/dental_portal

# MongoDB Atlas (production) — uncomment and fill in:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dental_portal?retryWrites=true&w=majority

TIMEZONE=Asia/Manila
DEFAULT_CURRENCY=PHP

# Number of trusted reverse proxies in front of the app, so the real client IP
# (X-Forwarded-For) is used for rate limiting instead of the proxy's IP. Leave 0
# locally. ⚠️ Set to the EXACT chain length — too high lets clients spoof their IP.
# Render: 1.  Cloudflare -> Render: 2.
# TRUSTED_PROXY_COUNT=2

# Error tracking (Sentry) — PROD ONLY. Leave UNSET locally and on the showcase
# so they stay silent. Set this only in the Render prod environment. PHI-safe:
# request bodies, cookies, IPs, and stack-frame locals are never sent.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
